# Firebase Realtime Database URL for the shared plan.
#
# Copy the URL from the Firebase console:
#   Realtime Database -> your database -> the URL at the top
# It looks like https://your-project-id-default-rtdb.firebaseio.com
#
# Leave this file's value empty (or leave the variable unset) to keep the plan
# local to one browser.
VITE_FIREBASE_DB_URL=

# Optional: protect editing with a passphrase. When set, the plan stays
# read-only for everyone else and only the unlocked browser can make changes.
# Share the read-only link; you enter the passphrase to edit. This is a
# simple gate, not strong security (the database URL still lives in the bundle).
#
# Generate the hash (use Node's built-in crypto):
#   node -e "console.log(require('crypto').createHash('sha256').update('your-passphrase').digest('hex'))"
VITE_OWNER_PASSPHRASE_HASH=
